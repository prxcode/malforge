# =============================================================================
# MAP — Malware Analysis Platform
# Environment Configuration
# =============================================================================

# ---------- Database ----------
POSTGRES_USER=map_user
POSTGRES_PASSWORD=map_secret_password
POSTGRES_DB=map_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://map_user:map_secret_password@db:5432/map_db

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- MinIO (Object Storage) ----------
MINIO_ROOT_USER=map_minio_admin
MINIO_ROOT_PASSWORD=map_minio_secret
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_SAMPLES=map-samples
MINIO_USE_SSL=false

# ---------- JWT Authentication ----------
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- API ----------
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------- Celery ----------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------- Storage ----------
STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=500

# ---------- Analysis ----------
FLOSS_BINARY_PATH=/usr/local/bin/floss
VOLATILITY3_SYMBOLS_PATH=/app/symbols
